{
  "name": "vibecraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prebake.mjs dist/baked && node scripts/ktx2.mjs dist/baked",
    "build:fast": "tsc --noEmit && vite build",
    "prebake": "node scripts/prebake.mjs dist/baked",
    "voices": "node scripts/import-voices.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stats": "vitest run tests/stats.test.ts --reporter=verbose",
    "relay": "node scripts/relay.mjs",
    "arena": "vite-node scripts/arena.ts",
    "aimatch": "vite-node scripts/aiMatch.ts",
    "ktx2": "node scripts/ktx2.mjs dist/baked"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "ktx2-encoder": "^0.6.0",
    "playwright-core": "^1.58.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "pixi.js": "^8.5.2",
    "three": "^0.169.0"
  }
}
